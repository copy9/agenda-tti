{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "node --test \"test/**/*.test.js\"" },
  "coverageAnalysis": "off",
  "mutate": ["src/policy.js", "src/views.js", "src/store.js", "src/util.js"],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "thresholds": { "high": 80, "low": 60, "break": 50 },
  "timeoutMS": 60000,
  "concurrency": 2
}
