# Copie para ".env" e preencha. No Docker, o docker-compose lê este arquivo.

# --- Obrigatórios ---
# Acesso ao painel de administração (5 cliques na logo do rodapé). Troque a senha!
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-longa

# Endereço público do site, sem barra no final. Usado nos links de convite.
PUBLIC_URL=https://agenda.seudominio.com.br

# --- Opcionais ---
PORT=3000
NODE_ENV=production
SESSION_DAYS=30

# --- Banco de dados ---
# Sem nenhuma variável DB_*, usa SQLite (um arquivo em ./data). Serve bem para começar.
# SQLITE_FILE=/app/data/agenda-tti.db
#
# Para MySQL/MariaDB (ex.: Hostinger), preencha estas quatro:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# --- Observabilidade (tudo opcional) ---
# LOG_LEVEL=info                      # debug | info | warn | error (logs em JSON, uma linha por evento)
# METRICS_TOKEN=gere-um-token-longo   # liga GET /metrics (Prometheus) com "Authorization: Bearer <token>"
# SENTRY_DSN=                         # erros no Sentry (npm i @sentry/node)
# SENTRY_ENVIRONMENT=production
# RELEASE=1.0.0
# TRACES_SAMPLE_RATE=0.1
# OpenTelemetry (npm i @opentelemetry/sdk-node @opentelemetry/auto-instrumentations-node):
# OTEL_SERVICE_NAME=agenda-tti
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=

# --- Termos de uso e privacidade ---
# COMPANY_NAME=Agenda TTI             # nome da empresa que aparece nos textos legais
# LEGAL_CONTACT=privacidade@seudominio.com   # contato do encarregado e para pedidos de titulares (padrão: ADMIN_EMAIL)
# LEGAL_VERSION=2026-10-12            # mude quando o texto mudar: todos precisam aceitar de novo
# LEGAL_REVIEWED=1                    # só depois da revisão de advogado: retira o aviso de "minuta" das páginas
# DELETE_GRACE_DAYS=7                 # carência para a exclusão de conta pedida pelo usuário
