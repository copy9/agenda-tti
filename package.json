{
  "name": "agenda-tti-servidor",
  "version": "1.0.0",
  "description": "Servidor da Agenda TTI: agenda e comunicação entre proprietários e corretores",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "DB_DRIVER=sqlite node server.js",
    "test": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-include=\"scripts/**/*.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\"",
    "check:db": "node scripts/check-db.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:commit": "node scripts/check-commit-msg.js",
    "publish:github": "node scripts/publish-github.js",
    "build:front": "python3 scripts/make-front.py front/source.html public/index.html",
    "check:fast": "node scripts/arch-contract.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "arch": "node scripts/arch-contract.js",
    "knip": "knip",
    "mutation": "stryker run",
    "check": "npm run lint && npm run arch && npm run knip && npm test",
    "test:fast": "node --test \"test/**/*.test.js\"",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {},
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "knip": "^5.0.0",
    "@stryker-mutator/core": "^9.0.0",
    "@playwright/test": "^1.50.0"
  }
}
